---
import Base from '../layouts/Base.astro';
import Panorama from '../components/Panorama.astro';
import PixelIcon from '../components/PixelIcon.astro';

const CONTACT = ''; // TODO: set the real contact address before submitting the AppID form

const splashes = [
  'Fair play only!', 'Written in Rust!', 'Now with NeoForge!', 'Encrypted with DPAPI!', 'No telemetry!',
  'Java included!', 'Also has a HUD editor!', 'Dependencies included!', '0% password!', 'Made for Windows!',
];

type Item = { id: string; name: string; by: string; text: string; needs?: string[] };
const catalog: Record<'mods' | 'packs' | 'shaders', Item[]> = {
  mods: [
    { id: 'sodium', name: 'Sodium', by: 'CaffeineMC', text: 'Rewrites the rendering engine for much higher frame rates.' },
    { id: 'lithium', name: 'Lithium', by: 'CaffeineMC', text: 'Optimises game logic: mobs, physics, chunk ticking.' },
    { id: 'iris', name: 'Iris Shaders', by: 'IrisShaders', text: 'Shader pack support that works together with Sodium.', needs: ['sodium'] },
    { id: 'modmenu', name: 'Mod Menu', by: 'Prospector', text: 'Lists installed mods in-game and opens their settings.', needs: ['fabric-api'] },
    { id: 'appleskin', name: 'AppleSkin', by: 'squeek502', text: 'Shows hunger and saturation values on the HUD.', needs: ['fabric-api'] },
    { id: 'fabric-api', name: 'Fabric API', by: 'FabricMC', text: 'Core library most Fabric mods depend on.' },
    { id: 'ferritecore', name: 'FerriteCore', by: 'malte0811', text: 'Cuts memory usage, especially in big modpacks.' },
    { id: 'entityculling', name: 'Entity Culling', by: 'tr7zw', text: 'Skips rendering entities you cannot see.' },
  ],
  packs: [
    { id: 'faithful', name: 'Faithful 32x', by: 'Faithful Team', text: 'The vanilla look at double resolution.' },
    { id: 'darkmode', name: 'Default Dark Mode', by: 'nebulr', text: 'Dark menus and inventories, same layout.' },
    { id: 'staytrue', name: 'Stay True', by: 'haylee', text: 'Subtle vanilla-style texture refresh.' },
  ],
  shaders: [
    { id: 'complementary', name: 'Complementary Reimagined', by: 'EminGT', text: 'Vanilla-friendly shaders with a soft, clean look.', needs: ['iris'] },
    { id: 'bsl', name: 'BSL Shaders', by: 'capttatsu', text: 'Bright, colourful lighting and water.', needs: ['iris'] },
    { id: 'makeup', name: 'MakeUp Ultra Fast', by: 'XavierFST', text: 'Shader look that runs on weaker GPUs.', needs: ['iris'] },
  ],
};
const all = Object.values(catalog).flat();
const kindOf = Object.fromEntries(Object.entries(catalog).flatMap(([k, items]) => items.map((i) => [i.id, k])));

// pixel identicon per project: 5x5 mirrored grid in a hue from the name
function icon(name: string) {
  let h = 2166136261;
  for (const c of name) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  const hue = Math.abs(h) % 360, cells: string[] = [];
  for (let y = 0; y < 5; y++) for (let x = 0; x < 3; x++) {
    if ((h >>> (y * 3 + x)) & 1) {
      cells.push(`M${x + 1} ${y + 1}h1v1H${x + 1}z`);
      if (x < 2) cells.push(`M${5 - x} ${y + 1}h1v1H${5 - x}z`);
    }
  }
  return { bg: `hsl(${hue} 40% 18%)`, fg: `hsl(${hue} 70% 68%)`, d: cells.join('') };
}
const tabs = [
  { id: 'mods', label: 'Mods' },
  { id: 'packs', label: 'Resource packs' },
  { id: 'shaders', label: 'Shaders' },
] as const;
---
<Base title="DaClient: launcher and client for Minecraft" description="DaClient is a free Minecraft: Java Edition launcher for Windows: instances, mod loaders, managed Java, one-click mods and a fair-play in-game client. Sign-in uses the official Microsoft account flow.">
<!--
THESIS: The landing page is DaClient's own title screen, the thing the client mod replaces in-game. Refuses the launcher-site default of headline + screenshot + feature-card grid.
OWN-WORLD: Purple-tinted stone tile ground, a pixel dusk panorama, bevelled GUI buttons with black edges, inset wells for lists, yellow splash text, in-game tooltip purple. Sora for everything, JetBrains Mono only for codes and paths.
STORY: Players recognise the title screen, try installing mods, packs and shaders in an interactive content screen, and see dependencies handled for them. Reviewers reach the privacy policy in one click.
FIRST VIEWPORT: Full-bleed panorama; DaClient wordmark centred with a pulsing splash; one-line description; stacked buttons Install mods / Privacy policy with a sound toggle; status bar with version left, Mojang disclaimer right.
FORM: Title Screen, own list #2 (pick card), seed b1be820b.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->

<header class="minibar" data-minibar aria-label="Site">
  <a class="mini-brand" href="#top"><img src={`${import.meta.env.BASE_URL}favicon.svg`.replace('//', '/')} width="22" height="22" alt="" />DaClient</a>
  <nav class="mini-nav">
    <a class="btn" href="#mods">Mods</a>
    <a class="btn" href="#privacy">Privacy</a>
  </nav>
</header>

<main>
  <!-- ============ TITLE SCREEN ============ -->
  <section class="title" id="top">
    <Panorama />
    <div class="title-shade" aria-hidden="true"></div>

    <div class="title-center">
      <div class="wordmark">
        <h1 class="wm-text">DaClient</h1>
        <button class="splash" type="button" data-splash data-list={JSON.stringify(splashes)} title="Click for another splash">{splashes[0]}</button>
      </div>
      <p class="tagline">A free launcher and in-game client for Minecraft: Java&nbsp;Edition on Windows.</p>

      <nav class="menu" aria-label="Title menu">
        <a class="btn" href="#mods">Install mods</a>
        <div class="menu-row">
          <button class="btn sq" type="button" data-sound aria-pressed="false" aria-label="Button sounds">
            <span class="ico-off"><PixelIcon name="speaker-off" size={20} /></span>
            <span class="ico-on"><PixelIcon name="speaker" size={20} /></span>
          </button>
          <a class="btn" href="#privacy">Privacy policy</a>
        </div>
      </nav>
    </div>

    <div class="statusbar">
      <span>DaClient 0.1.0-dev · Windows · in development</span>
      <span>Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.</span>
    </div>
  </section>

  <!-- ============ MODS ============ -->
  <section class="screen" id="mods" aria-labelledby="mods-h">
    <div class="screen-head"><h2 class="screen-title" id="mods-h">Mods, packs and shaders</h2></div>
    <div class="screen-inner">
      <p class="screen-lede">Search Modrinth, press install, play. DaClient picks the build that matches your instance and pulls in everything it depends on. Try it below.</p>

      <div class="guide" data-reveal aria-hidden="true">
        <span class="g" data-g="0">Search</span><span class="g" data-g="1">Install</span><span class="g" data-g="2">Manage</span>
      </div>

      <div class="store" data-store>
        <div class="store-bar">
          <div class="inst-chip"><PixelIcon name="grass" size={28} /><span><b>Survival</b><span>1.21.10 · Fabric</span></span></div>
          <div class="views" role="tablist" aria-label="View">
            <button class="btn" role="tab" type="button" data-view="browse" aria-selected="true">Browse</button>
            <button class="btn" role="tab" type="button" data-view="installed" aria-selected="false">Installed <span class="count" data-count>0</span></button>
          </div>
        </div>

        <!-- browse -->
        <div class="pane" data-pane="browse">
          <div class="filters">
            <div class="kinds" role="tablist" aria-label="Content type">
              {tabs.map((t, i) => <button class="btn" role="tab" type="button" data-kind={t.id} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>)}
            </div>
            <label class="search well">
              <span class="sr-only">Search</span>
              <svg viewBox="0 0 16 16" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true" fill="currentColor"><path d="M5 2h4v1H5zM4 3h1v1H4zM9 3h1v1H9zM3 4h1v4H3zM10 4h1v4h-1zM4 8h1v1H4zM9 8h1v1H9zM5 9h4v1H5zM10 10h1v1h-1zM11 11h1v1h-1zM12 12h1v1h-1z"/></svg>
              <input type="search" placeholder="Search mods…" data-search autocomplete="off" spellcheck="false" />
            </label>
          </div>

          <ul class="well results" data-results>
            {all.map((m) => {
              const ic = icon(m.name);
              return (
                <li class="res" data-id={m.id} data-kind={kindOf[m.id]} data-name={m.name.toLowerCase()} data-needs={(m.needs ?? []).join(',')} hidden={kindOf[m.id] !== 'mods'}>
                  <svg class="res-ic" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true"><rect width="7" height="7" fill={ic.bg} /><path d={ic.d} fill={ic.fg} /></svg>
                  <div class="res-text">
                    <b>{m.name}</b> <span class="by">by {m.by}</span>
                    <p>{m.text}</p>
                    {m.needs && <p class="needs">Needs {m.needs.map((n) => all.find((a) => a.id === n)!.name).join(', ')}</p>}
                  </div>
                  <button class="btn install" type="button" data-install>Install</button>
                </li>
              );
            })}
            <li class="empty" data-empty hidden>Nothing found. Try “sodium” or “shader”.</li>
          </ul>
        </div>

        <!-- installed -->
        <div class="pane" data-pane="installed" hidden>
          <ul class="well installed" data-installed>
            <li class="empty" data-empty-installed>Nothing installed yet. Pick something under Browse.</li>
          </ul>
        </div>

        <p class="toast" data-toast role="status" aria-live="polite"></p>
      </div>
      <p class="note">Demo with a fixed list of real Modrinth projects. Search and install already work in the command-line version; the launcher app is in progress.</p>
      <div class="done-row"><a class="btn" href="#top">Done</a></div>
    </div>
  </section>

  <!-- ============ PRIVACY ============ -->
  <section class="screen" id="privacy" aria-labelledby="privacy-h">
    <div class="screen-head"><h2 class="screen-title" id="privacy-h">Privacy policy</h2></div>
    <div class="screen-inner">
      <p class="screen-lede">Last updated 18 October 2026. Applies to the DaClient launcher and the DaClient in-game mod.</p>

      <div class="policy">
        <nav class="policy-nav" aria-label="Privacy policy sections">
          <a class="btn" href="#p-short">Summary</a>
          <a class="btn" href="#p-signin">Microsoft sign-in</a>
          <a class="btn" href="#p-stored">Stored data</a>
          <a class="btn" href="#p-services">Services</a>
          <a class="btn" href="#p-delete">Removing data</a>
          <a class="btn" href="#p-contact">Contact</a>
        </nav>

        <article class="well policy-text">
          <h3 id="p-short">Summary</h3>
          <p>DaClient runs entirely on your computer. We do not operate servers, collect analytics or sell data. Account data is stored locally and only sent to Microsoft and Mojang to sign you in and start the game.</p>

          <h3 id="p-signin">Microsoft sign-in</h3>
          <p>You sign in on Microsoft's own website with a one-time code (OAuth 2.0 device code flow), so DaClient never sees your password. It requests two scopes, <code>XboxLive.signin</code> and <code>offline_access</code>. The Microsoft token is exchanged for Xbox Live and XSTS tokens, then for a Minecraft token, which is used to check game ownership, read your profile and start the game.</p>

          <h3 id="p-stored">Data stored on your device</h3>
          <ul>
            <li>Microsoft, Xbox Live and Minecraft access and refresh tokens, encrypted with Windows DPAPI so only your Windows user account can read them.</li>
            <li>Your Minecraft profile: username, UUID and skin.</li>
            <li>Launcher settings, instances, installed versions, mods and play time.</li>
          </ul>
          <p>Everything is kept in <code>%APPDATA%\DaClient</code>. Deleting this folder removes it completely.</p>

          <h3 id="p-services">Services the launcher connects to</h3>
          <table>
            <tbody>
              <tr><th scope="row">Microsoft identity</th><td><code>login.microsoftonline.com</code>, account sign-in</td></tr>
              <tr><th scope="row">Xbox Live</th><td><code>user.auth.xboxlive.com</code>, <code>xsts.auth.xboxlive.com</code></td></tr>
              <tr><th scope="row">Minecraft services</th><td><code>api.minecraftservices.com</code>, game token, ownership and profile</td></tr>
              <tr><th scope="row">Mojang downloads</th><td>Game files, libraries, assets and Java runtimes</td></tr>
              <tr><th scope="row">Mod loaders</th><td>Fabric, Quilt, Forge and NeoForge metadata and files</td></tr>
              <tr><th scope="row">Modrinth</th><td><code>api.modrinth.com</code>, <code>cdn.modrinth.com</code>, searching and downloading mods, resource packs, shaders and modpacks</td></tr>
            </tbody>
          </table>
          <p>These requests fall under the privacy policies of the respective providers, including the <a href="https://privacy.microsoft.com/privacystatement">Microsoft Privacy Statement</a>. There is no telemetry, analytics or tracking, in the launcher or on this website, and no data is shared with anyone beyond the services listed above.</p>

          <h3 id="p-delete">Removing your data</h3>
          <p>Remove an account inside the launcher to delete its tokens, or delete the <code>%APPDATA%\DaClient</code> folder to remove everything. You can also revoke DaClient's access at any time at <a href="https://account.live.com/consent/Manage">account.live.com/consent/Manage</a>.</p>

          <h3 id="p-contact">Contact</h3>
          <p>Questions about this policy: {CONTACT ? <a href={`mailto:${CONTACT}`}>{CONTACT}</a> : <span class="placeholder">contact address coming soon</span>}</p>
        </article>
      </div>
      <div class="done-row"><a class="btn" href="#top">Done</a></div>
    </div>
  </section>
</main>

<footer class="foot">
  <a class="btn" href="#top"><PixelIcon name="arrow-up" size={18} />Back to title</a>
  <p>NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT. Minecraft is a trademark of Mojang AB.</p>
  <p>© 2026 DaClient</p>
</footer>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

  /* ---------- button sounds (off by default) ---------- */
  let audio: AudioContext | null = null;
  let soundOn = false;
  function blip(pitch = 1, len = 0.08) {
    if (!soundOn) return;
    audio ??= new AudioContext();
    const t = audio.currentTime, o = audio.createOscillator(), g = audio.createGain(), f = audio.createBiquadFilter();
    o.type = 'square'; o.frequency.setValueAtTime(880 * pitch, t); o.frequency.exponentialRampToValueAtTime(220 * pitch, t + len * 0.75);
    f.type = 'lowpass'; f.frequency.value = 2400;
    g.gain.setValueAtTime(0.08, t); g.gain.exponentialRampToValueAtTime(0.0001, t + len);
    o.connect(f).connect(g).connect(audio.destination); o.start(t); o.stop(t + len + 0.01);
  }
  const soundBtn = document.querySelector<HTMLButtonElement>('[data-sound]')!;
  soundBtn.addEventListener('click', () => {
    soundOn = !soundOn; soundBtn.setAttribute('aria-pressed', String(soundOn));
    try { localStorage.setItem('dac-sound', soundOn ? '1' : '0'); } catch {}
    blip(1.2);
  });
  try { if (localStorage.getItem('dac-sound') === '1') { soundOn = true; soundBtn.setAttribute('aria-pressed', 'true'); } } catch {}
  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest('.btn, [data-splash]');
    if (el && el !== soundBtn && !el.hasAttribute('data-install')) blip();
  });

  /* ---------- splash text ---------- */
  const splash = document.querySelector<HTMLButtonElement>('[data-splash]')!;
  const list: string[] = JSON.parse(splash.dataset.list!);
  let si = 0;
  splash.addEventListener('click', () => {
    si = (si + 1 + Math.floor(Math.random() * (list.length - 1))) % list.length;
    splash.textContent = list[si];
    splash.classList.remove('pop'); void splash.offsetWidth; splash.classList.add('pop');
  });

  /* ---------- mini bar after the title screen ---------- */
  const bar = document.querySelector<HTMLElement>('[data-minibar]')!;
  new IntersectionObserver(([e]) => bar.classList.toggle('show', !e.isIntersecting), { rootMargin: '-40% 0px 0px 0px' })
    .observe(document.querySelector('.title')!);

  /* ---------- reveals ---------- */
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { rootMargin: '0px 0px -12% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  /* ---------- content store demo ---------- */
  const store = document.querySelector<HTMLElement>('[data-store]')!;
  const rows = [...store.querySelectorAll<HTMLLIElement>('.res')];
  const byId = new Map(rows.map((r) => [r.dataset.id!, r]));
  const search = store.querySelector<HTMLInputElement>('[data-search]')!;
  const empty = store.querySelector<HTMLElement>('[data-empty]')!;
  const installedList = store.querySelector<HTMLUListElement>('[data-installed]')!;
  const emptyInstalled = store.querySelector<HTMLElement>('[data-empty-installed]')!;
  const count = store.querySelector<HTMLElement>('[data-count]')!;
  const toast = store.querySelector<HTMLElement>('[data-toast]')!;
  const guide = [...document.querySelectorAll<HTMLElement>('[data-g]')];
  const installed = new Map<string, { on: boolean; auto: boolean }>();
  let kind = 'mods';

  const setGuide = (n: number) => guide.forEach((g, i) => { g.classList.toggle('now', i === n); g.classList.toggle('done', i < n); });
  setGuide(0);

  function filter() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const r of rows) {
      // a query searches every type, an empty query shows the chosen tab
      const hit = q ? r.dataset.name!.includes(q) || r.textContent!.toLowerCase().includes(q) : r.dataset.kind === kind;
      r.hidden = !hit; if (hit) shown++;
    }
    empty.hidden = shown > 0;
  }
  const kindTabs = [...store.querySelectorAll<HTMLButtonElement>('button[data-kind]')];
  kindTabs.forEach((b) => b.addEventListener('click', () => {
    kind = b.dataset.kind!; search.value = '';
    kindTabs.forEach((o) => o.setAttribute('aria-selected', String(o === b)));
    search.placeholder = `Search ${b.textContent!.toLowerCase()}…`;
    filter();
  }));
  search.addEventListener('input', () => { filter(); if (search.value) setGuide(Math.max(0, guide.findIndex((g) => g.classList.contains('now')))); });

  function setView(v: string) {
    store.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.view === v)));
    store.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== v));
  }
  store.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
    setView(b.dataset.view!); if (b.dataset.view === 'installed' && installed.size) setGuide(3);
  }));

  let toastTimer = 0;
  function say(msg: string) {
    toast.textContent = msg; toast.classList.add('show');
    clearTimeout(toastTimer); toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3800);
  }

  // resolve the full dependency chain, dependencies first
  function chain(id: string, out: string[] = []): string[] {
    for (const d of (byId.get(id)!.dataset.needs || '').split(',').filter(Boolean)) chain(d, out);
    if (!out.includes(id)) out.push(id);
    return out;
  }
  const nameOf = (id: string) => byId.get(id)!.querySelector('b')!.textContent!;

  async function install(id: string) {
    const todo = chain(id).filter((x) => !installed.has(x));
    if (!todo.length) return;
    const extra = todo.filter((x) => x !== id);
    if (extra.length) say(`${nameOf(id)} needs ${extra.map(nameOf).join(' and ')}. Added automatically.`);
    for (const x of todo) {
      const btn = byId.get(x)!.querySelector<HTMLButtonElement>('[data-install]')!;
      btn.disabled = true; btn.classList.add('busy'); btn.textContent = '';
      btn.style.setProperty('--p', '0');
      for (let k = 1; k <= 10; k++) { await sleep(55); btn.style.setProperty('--p', String(k / 10)); }
      btn.classList.remove('busy'); btn.textContent = 'Installed'; btn.classList.add('done');
      installed.set(x, { on: true, auto: x !== id });
      blip(1.5, 0.06);
      addInstalled(x);
    }
    blip(2, 0.12);
    if (!extra.length) say(`${nameOf(id)} installed into Survival.`);
    setGuide(2);
  }

  function addInstalled(id: string) {
    const src = byId.get(id)!;
    const li = document.createElement('li'); li.className = 'inst-row'; li.dataset.id = id;
    const kindLabel = { mods: 'Mod', packs: 'Resource pack', shaders: 'Shader' }[src.dataset.kind!];
    li.innerHTML = `${src.querySelector('.res-ic')!.outerHTML}
      <div class="res-text"><b>${nameOf(id)}</b><p>${kindLabel}${installed.get(id)!.auto ? ' · added as dependency' : ''}</p></div>
      <button class="btn toggle" type="button" aria-pressed="true">ON</button>
      <button class="btn sq remove" type="button" aria-label="Remove ${nameOf(id)}">
        <svg viewBox="0 0 16 16" width="16" height="16" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true"><path d="M3 3h2v2H3zM5 5h2v2H5zM7 7h2v2H7zM9 9h2v2H9zM11 11h2v2h-2zM11 3h2v2h-2zM9 5h2v2H9zM5 9h2v2H5zM3 11h2v2H3z"/></svg>
      </button>`;
    installedList.append(li);
    emptyInstalled.hidden = true; count.textContent = String(installed.size);
    count.classList.remove('bump'); void count.offsetWidth; count.classList.add('bump');
  }

  installedList.addEventListener('click', (e) => {
    const li = (e.target as Element).closest<HTMLLIElement>('.inst-row'); if (!li) return;
    const id = li.dataset.id!;
    if ((e.target as Element).closest('.toggle')) {
      const st = installed.get(id)!; st.on = !st.on;
      const t = li.querySelector<HTMLButtonElement>('.toggle')!;
      t.textContent = st.on ? 'ON' : 'OFF'; t.setAttribute('aria-pressed', String(st.on)); li.classList.toggle('off', !st.on);
    }
    if ((e.target as Element).closest('.remove')) {
      installed.delete(id); li.remove();
      const btn = byId.get(id)!.querySelector<HTMLButtonElement>('[data-install]')!;
      btn.disabled = false; btn.classList.remove('done'); btn.textContent = 'Install';
      count.textContent = String(installed.size); emptyInstalled.hidden = installed.size > 0;
      say(`${nameOf(id)} removed.`);
    }
  });

  rows.forEach((r) => r.querySelector('[data-install]')!.addEventListener('click', () => { setGuide(1); install(r.dataset.id!); }));
</script>

<style>
  /* ---------- mini bar ---------- */
  .minibar {
    position: fixed; inset: 0 0 auto; z-index: 20; height: 60px;
    display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 16px;
    background: rgba(11, 9, 18, 0.92); border-bottom: 2px solid var(--edge);
    box-shadow: inset 0 -2px 0 rgba(255, 255, 255, 0.06), 0 6px 18px rgba(0, 0, 0, 0.4);
    transform: translateY(-110%); transition: transform 380ms var(--ease-out);
  }
  .minibar.show { transform: none; }
  .mini-brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 700; letter-spacing: 0.01em; }
  .mini-brand img { image-rendering: pixelated; }
  .mini-nav { display: flex; gap: 6px; }
