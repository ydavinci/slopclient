[Unit]
Description=DaClient cosmetics backend
After=network-online.target
Wants=network-online.target

[Service]
User=daclient
Group=daclient
WorkingDirectory=/var/lib/daclient-cosmetics
ExecStart=/usr/local/bin/daclient-cosmetics
Environment=DACLIENT_COSMETICS_BIND=127.0.0.1:8787
Environment=DACLIENT_COSMETICS_DATA=/var/lib/daclient-cosmetics
Environment=DACLIENT_COSMETICS_PUBLIC_URL=https://cosmetics.example.com
# Admin token for /v1/admin/* (reports, hiding capes); keep it out of the unit file:
EnvironmentFile=-/etc/daclient-cosmetics.env
Restart=on-failure
# Hardening: the service only needs its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/daclient-cosmetics

[Install]
WantedBy=multi-user.target
