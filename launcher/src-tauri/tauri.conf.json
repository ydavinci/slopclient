{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaClient",
  "version": "0.1.0",
  "identifier": "dev.daclient.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DaClient",
        "width": 1240,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "backgroundColor": "#09080D"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
